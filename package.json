{
  "name": "hffmnnj.runes",
  "version": "0.1.0",
  "description": "Project-local reusable scripts for OpenCode V2, exposed as typed Code Mode tools.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hffmnnj/opencode-runes.git"
  },
  "homepage": "https://unpkg.com/hffmnnj.runes/README.md",
  "bugs": {
    "url": "https://github.com/hffmnnj/opencode-runes/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": ["dist", "README.md", "assets/banner.png", "docs/FORMAT.md", "docs/SECURITY.md"],
  "engines": {
    "bun": ">=1.4.2"
  },
  "packageManager": "bun@1.4.2",
  "dependencies": {
    "@opencode/plugin": "2.0.32"
  },
  "devDependencies": {
    "@types/bun": "1.3.5",
    "@types/json-schema": "7.0.15",
    "typescript": "5.9.3"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build": "bun build ./src/index.ts --outdir ./dist --target bun --external '@opencode/*'",
    "prepack": "bun run build",
    "check": "bun run typecheck && bun test && bun run build"
  }
}
