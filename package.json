{
  "name": "opencode-runes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": ["dist", "README.md"],
  "engines": {
    "bun": ">=1.4.2"
  },
  "packageManager": "bun@1.4.2",
  "dependencies": {
    "@opencode/plugin": "2.0.32"
  },
  "devDependencies": {
    "@types/bun": "1.3.5",
    "@types/json-schema": "7.0.15",
    "typescript": "5.9.3"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build": "bun build ./src/index.ts --outdir ./dist --target bun --external '@opencode/*'",
    "check": "bun run typecheck && bun test && bun run build"
  }
}
